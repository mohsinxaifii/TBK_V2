{%- comment -%}
  Off index this banner borrows the archives top banner wholesale: the same
  .page-top-banner-container frame (80vh / 60vh / 50vh, media cover-cropped),
  the same page-title + rule + shop-name caption, and the same reveal, which
  site-animations.js and page-top_banner.js both key off that class. Index is
  left out on purpose — its hero is the brand film, which has to keep its own
  aspect ratio rather than be cropped to a viewport fraction.
{%- endcomment -%}
{%- liquid
  assign framed = true
  if request.page_type == 'index'
    assign framed = false
  endif
-%}

{{ 'custom-banner.css' | asset_url | stylesheet_tag }}
{{ 'custom-banner-audio.css' | asset_url | stylesheet_tag }}
{%- if framed -%}
  {{ 'page-top_banner.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<script src="{{ 'gsap.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'custom-banner-audio.js' | asset_url }}" defer="defer"></script>
{%- if framed -%}
  <script src="{{ 'page-top_banner.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- comment -%}
  data-custom-banner-pin is custom-banner-audio.js's root hook; the scroll pin
  it was originally named for is gone.
{%- endcomment -%}
<div class="custom-banner-pin-space" data-custom-banner-pin>
  {%- assign show_video_audio_controls = false -%}
  {%- if section.settings.media_type == 'video' -%}
    {%- if section.settings.banner_video != blank or section.settings.mobile_banner_video != blank -%}
      {%- assign show_video_audio_controls = true -%}
    {%- endif -%}
  {%- endif -%}

  <div class="custom-banner-sticky">
    <div class="custom-banner-container{% if framed %} page-top-banner-container{% endif %}">
      {%- comment -%}
        Both breakpoints' media sit in the markup and CSS toggles which one
        shows, so nothing here may fetch eagerly on its own: videos carry
        preload="none" and no autoplay attribute, and custom-banner-audio.js
        starts only the variant that is actually visible (see
        initBannerPlayback). The poster is what paints first -- and what
        stays up when iOS Low Power Mode refuses autoplay -- so it gets the
        high-priority preload, scoped by media query to the one that shows.
      {%- endcomment -%}
      {%- if section.settings.media_type == 'video' and section.settings.banner_video != blank -%}
        {%- assign desktop_video = section.settings.banner_video -%}
        {%- if desktop_video.preview_image -%}
          <link
            rel="preload"
            as="image"
            href="{{ desktop_video.preview_image | image_url: width: 1920 }}"
            media="(min-width: 750px)"
            fetchpriority="high"
          >
        {%- endif -%}
        {{
          desktop_video
          | video_tag:
            class: 'custom-banner_desktop-video',
            image_size: '1920x',
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'none'
        }}
      {%- else -%}
        {{
          section.settings.banner_image
          | image_url: width: 3000
          | image_tag:
            class: 'custom-banner_desktop-image',
            widths: '750, 1100, 1500, 1920, 2400, 3000',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- endif -%}

      {%- if section.settings.media_type == 'video' and section.settings.mobile_banner_video != blank -%}
        {%- assign mobile_video = section.settings.mobile_banner_video -%}
        {%- if mobile_video.preview_image -%}
          <link
            rel="preload"
            as="image"
            href="{{ mobile_video.preview_image | image_url: width: 1080 }}"
            media="(max-width: 749px)"
            fetchpriority="high"
          >
        {%- endif -%}
        {{
          mobile_video
          | video_tag:
            class: 'custom-banner_mobile-video',
            image_size: '1080x',
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'none'
        }}
      {%- else -%}
        {{
          section.settings.mobile_banner_image
          | image_url: width: 1500
          | image_tag:
            class: 'custom-banner_mobile-image',
            widths: '375, 550, 750, 1080, 1500',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- endif -%}

      {%- if show_video_audio_controls -%}
        <button type="button" class="custom-banner-mute-toggle" aria-pressed="true" aria-label="Unmute video">
          <span class="custom-banner-mute-icon custom-banner-mute-icon-muted" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="currentColor">
              <path d="M2 6h2.3L8 3.2v9.6L4.3 10H2V6z" />
              <path
                d="M11 6.2l3.2 3.6M14.2 6.2L11 9.8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
              />
            </svg>
          </span>
          <span class="custom-banner-mute-icon custom-banner-mute-icon-unmuted" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="currentColor">
              <path d="M2 6h2.3L8 3.2v9.6L4.3 10H2V6z" />
              <path
                d="M10.4 5.6a3.4 3.4 0 0 1 0 4.8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
              />
              <path
                d="M12.2 3.8a6.2 6.2 0 0 1 0 8.4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
              />
            </svg>
          </span>
        </button>

        <div class="custom-banner-cursor-tag" aria-hidden="true">
          <span class="custom-banner-cursor-tag-flip">
            <span class="custom-banner-cursor-tag-text-mask">
              <span class="custom-banner-cursor-tag-text">Unmute Video</span>
            </span>
          </span>
        </div>
      {%- endif -%}

      {%- if framed and page.title != blank -%}
        <div class="page-top-banner-container-inner">
          <p>{{ page.title }}</p>
          <hr>
          <p>{{ shop.name }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_banner_image",
      "label": "Mobile Banner Image"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "banner_video",
      "label": "Banner Video"
    },
    {
      "type": "video",
      "id": "mobile_banner_video",
      "label": "Mobile Banner Video"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
