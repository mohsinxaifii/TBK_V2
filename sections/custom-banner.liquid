{%- comment -%}
  Off index this banner borrows the archives top banner wholesale: the same
  .page-top-banner-container frame (80vh / 60vh / 50vh, media cover-cropped),
  the same page-title + rule + shop-name caption, and the same reveal, which
  site-animations.js and page-top_banner.js both key off that class. Index is
  left out on purpose — its hero is the brand film, which has to keep its own
  aspect ratio rather than be cropped to a viewport fraction.
{%- endcomment -%}
{%- liquid
  assign framed = true
  if request.page_type == 'index'
    assign framed = false
  endif
-%}

{{ 'custom-banner.css' | asset_url | stylesheet_tag }}
{{ 'custom-banner-audio.css' | asset_url | stylesheet_tag }}
{%- if framed -%}
  {{ 'page-top_banner.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<script src="{{ 'gsap.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'custom-banner-audio.js' | asset_url }}" defer="defer"></script>
{%- if framed -%}
  <script src="{{ 'page-top_banner.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- comment -%}
  data-custom-banner-pin is custom-banner-audio.js's root hook; the scroll pin
  it was originally named for is gone.
{%- endcomment -%}
<div class="custom-banner-pin-space" data-custom-banner-pin>
  {%- assign show_video_audio_controls = false -%}
  {%- if section.settings.media_type == 'video' -%}
    {%- if section.settings.banner_video != blank or section.settings.mobile_banner_video != blank -%}
      {%- assign show_video_audio_controls = true -%}
    {%- endif -%}
  {%- endif -%}

  <div class="custom-banner-sticky{% unless framed %} custom-banner-sticky--hero{% endunless %}">
    <div class="custom-banner-container{% if framed %} page-top-banner-container{% endif %}{% if show_video_audio_controls %} custom-banner-container--video{% endif %}"
      {%- if section.settings.media_type == 'video' and section.settings.mobile_banner_video != blank %} style="--mobile-video-ratio: {{ section.settings.mobile_banner_video.aspect_ratio }}"{% endif -%}
    >
      {%- comment -%}
        Both breakpoints' media sit in the markup and CSS toggles which one
        shows, so nothing here may fetch eagerly on its own: videos carry
        preload="none" and no autoplay attribute (see snippets/banner-video),
        and the inline starter below plays only the variant that is actually
        visible, with custom-banner-audio.js taking over from there. Until the video is actually playing the frame is
        solid #570f13 -- the video (poster included) stays transparent and
        fades in on its first `playing` event (.is-ready), so no poster or
        half-loaded frame flashes in first. When iOS Low Power Mode refuses
        autoplay it stays on that colour until the first tap starts it.
        Images get the same guarantee from <picture>: each swaps in a 1px
        blank at the other breakpoint, so the hidden one never downloads
        while the visible one still loads eagerly as the LCP candidate.
        The inline aspect-ratio reserves the video's box before metadata
        arrives; the framed layout's height:100% overrides it.
      {%- endcomment -%}
      {%- if section.settings.media_type == 'video' and section.settings.banner_video != blank -%}
        {%- render 'banner-video',
          video: section.settings.banner_video,
          class: 'custom-banner_desktop-video',
          mp4_height: 1080
        -%}
      {%- elsif section.settings.banner_image != blank -%}
        <picture class="custom-banner-picture">
          <source media="(max-width: 749px)" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==">
          {{
          section.settings.banner_image
          | image_url: width: 3000
          | image_tag:
            class: 'custom-banner_desktop-image',
            widths: '750, 1100, 1500, 1920, 2400, 3000',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high'
          }}
        </picture>
      {%- endif -%}

      {%- if section.settings.media_type == 'video' and section.settings.mobile_banner_video != blank -%}
        {%- render 'banner-video',
          video: section.settings.mobile_banner_video,
          class: 'custom-banner_mobile-video',
          mp4_height: 720
        -%}
      {%- elsif section.settings.mobile_banner_image != blank -%}
        <picture class="custom-banner-picture">
          <source media="(min-width: 750px)" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==">
          {{
          section.settings.mobile_banner_image
          | image_url: width: 1500
          | image_tag:
            class: 'custom-banner_mobile-image',
            widths: '375, 550, 750, 1080, 1500',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high'
          }}
        </picture>
      {%- endif -%}

      {%- if show_video_audio_controls -%}
        {%- comment -%}
          Starts the visible video the moment the parser reaches it, instead
          of waiting for custom-banner-audio.js: that is deferred and wrapped
          in DOMContentLoaded, so it only ran after every deferred script on
          the page (GSAP, Lenis, the lot) had loaded -- on iPhones that was
          seconds of an empty maroon frame. Browsers have no priority hint for
          <video> (Safari ignores preload as=video), so starting it early is
          the lever. Only the visible variant is touched, so the hidden one
          still never downloads; the deferred script takes over from here
          (pausing off-screen, the Low Power Mode tap retry, breakpoint swaps).
        {%- endcomment -%}
        <script>
          (function (root) {
            var videos = root.querySelectorAll('.custom-banner_desktop-video, .custom-banner_mobile-video');
            var reveal = function () { this.classList.add('is-ready'); };
            for (var i = 0; i < videos.length; i++) {
              // First decoded frame is enough to lift the maroon: a paused
              // first frame (autoplay refused) still beats an empty block.
              videos[i].addEventListener('loadeddata', reveal, { once: true });
              videos[i].addEventListener('playing', reveal, { once: true });
            }
            if (navigator.connection && navigator.connection.saveData) return;
            var mobile = window.matchMedia('(max-width: 749px)').matches;
            var video = root.querySelector(mobile ? '.custom-banner_mobile-video' : '.custom-banner_desktop-video');
            if (!video) return;
            // Hold every other deferred media download (window.heroMedia, see
            // theme.liquid) until this film has its first frame.
            var hero = window.heroMedia;
            if (hero) {
              hero.claim();
              video.addEventListener('loadeddata', function () { hero.done(); }, { once: true });
              video.addEventListener('error', function () { hero.done(); }, { once: true });
            }
            video.muted = true;
            video.defaultMuted = true;
            video.playsInline = true;
            video.preload = 'auto';
            var play = function () {
              var attempt = video.play();
              if (attempt && attempt.catch) attempt.catch(function () {});
            };
            play();
            // Watchdog: a first request that dies (flaky mobile network)
            // otherwise leaves the frame empty for good. Only a download that
            // has made no progress for 5s counts -- a slow one that is still
            // arriving must be left alone, since load() restarts it from zero.
            var retries = 0;
            var lastProgress = Date.now();
            video.addEventListener('progress', function () { lastProgress = Date.now(); });
            var check = function () {
              if (video.readyState >= 2 || retries >= 2) return;
              if (Date.now() - lastProgress >= 5000) {
                retries++;
                lastProgress = Date.now();
                video.load();
                play();
              }
              setTimeout(check, 1000);
            };
            setTimeout(check, 5000);
          })(document.currentScript.parentElement);
        </script>

        <button type="button" class="custom-banner-mute-toggle" aria-pressed="true" aria-label="Unmute video">
          <span class="custom-banner-mute-icon custom-banner-mute-icon-muted" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="currentColor">
              <path d="M2 6h2.3L8 3.2v9.6L4.3 10H2V6z" />
              <path
                d="M11 6.2l3.2 3.6M14.2 6.2L11 9.8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
              />
            </svg>
          </span>
          <span class="custom-banner-mute-icon custom-banner-mute-icon-unmuted" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="currentColor">
              <path d="M2 6h2.3L8 3.2v9.6L4.3 10H2V6z" />
              <path
                d="M10.4 5.6a3.4 3.4 0 0 1 0 4.8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
              />
              <path
                d="M12.2 3.8a6.2 6.2 0 0 1 0 8.4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
              />
            </svg>
          </span>
        </button>

        <div class="custom-banner-cursor-tag" aria-hidden="true">
          <span class="custom-banner-cursor-tag-flip">
            <span class="custom-banner-cursor-tag-text-mask">
              <span class="custom-banner-cursor-tag-text">Unmute Video</span>
            </span>
          </span>
        </div>
      {%- endif -%}

      {%- if framed and page.title != blank -%}
        <div class="page-top-banner-container-inner">
          <p>{{ page.title }}</p>
          <hr>
          <p>{{ shop.name }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_banner_image",
      "label": "Mobile Banner Image"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "banner_video",
      "label": "Banner Video"
    },
    {
      "type": "video",
      "id": "mobile_banner_video",
      "label": "Mobile Banner Video"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
