{{ 'custom-manufacturing-units.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .manufacturing-units-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .manufacturing-units-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="manufacturing-units manufacturing-units-{{ section.id }}-padding"
  style="background-color: {{ section.settings.background_color }}; --manufacturing-units-accent: {{ section.settings.table_color }};"
>
  <div class="page-width manufacturing-units__inner">
    {%- if section.settings.heading != blank -%}
      <h1 class="manufacturing-units__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="manufacturing-units__table" role="table" aria-label="{{ section.settings.heading | escape }}">
        <div class="manufacturing-units__row manufacturing-units__row--head" role="row">
          <span role="columnheader">{{ section.settings.code_label | escape }}</span>
          <span role="columnheader">{{ section.settings.address_label | escape }}</span>
          <span role="columnheader">{{ section.settings.license_label | escape }}</span>
        </div>

        {%- for block in section.blocks -%}
          <div class="manufacturing-units__row" role="row" {{ block.shopify_attributes }}>
            <span class="manufacturing-units__code" role="cell">{{ block.settings.code | escape }}</span>
            <span class="manufacturing-units__address" role="cell">{{ block.settings.address | escape }}</span>
            <span class="manufacturing-units__license" role="cell">{{ block.settings.license | escape }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Manufacturing Units",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See first letter of batch no. for manufacturing unit address"
    },
    {
      "type": "text",
      "id": "code_label",
      "label": "Code column label",
      "default": "CODE"
    },
    {
      "type": "text",
      "id": "address_label",
      "label": "Address column label",
      "default": "ADDRESS"
    },
    {
      "type": "text",
      "id": "license_label",
      "label": "License column label",
      "default": "FSSAI LIC. NO."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fffdee"
    },
    {
      "type": "color",
      "id": "table_color",
      "label": "Table color",
      "default": "#570f13"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "unit",
      "name": "Unit",
      "settings": [
        {
          "type": "text",
          "id": "code",
          "label": "Code",
          "default": "CODE: (F)"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "license",
          "label": "FSSAI license no."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Manufacturing Units",
      "blocks": [
        {
          "type": "unit"
        }
      ]
    }
  ]
}
{% endschema %}
