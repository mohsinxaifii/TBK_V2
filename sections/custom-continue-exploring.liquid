{{ 'custom-continue-exploring.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .continue-exploring-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .continue-exploring-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="continue-exploring continue-exploring-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="continue-exploring__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="collection__subtitle">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign selected_blog = section.settings.blog
      assign article_limit = section.settings.article_limit
      assign display_count = 0
    -%}

    {%- if selected_blog != blank and selected_blog.articles.size > 0 -%}
      <div class="continue-exploring__grid">
        {%- for blog_article in selected_blog.articles -%}
          {%- if blog_article.id == article.id -%}
            {%- continue -%}
          {%- endif -%}
          {%- if display_count >= article_limit -%}
            {%- break -%}
          {%- endif -%}

          {%- liquid
            assign display_count = display_count | plus: 1

            # The story's own hero art, desktop and mobile — the same pair
            # blog-listing-grid and the article page use.
            assign tile_image_mobile = blog_article.metafields.custom.hero_image_mobile.value
            assign tile_image = blog_article.metafields.custom.hero_image.value | default: blog_article.image
            assign tile_alt = tile_image.alt | default: blog_article.title | strip_html | default: shop.name | escape
          -%}

          {%- comment -%}
            The tile's number is the article's own, not its position in this
            rail — this list skips the post being read, so position here would
            not match the number the same post shows in the listing grid or on
            its own hero. See snippets/story-number.liquid.
          {%- endcomment -%}
          {%- capture index_padded -%}
            {%- render 'story-number', article: blog_article, fallback: display_count -%}
          {%- endcapture -%}

          <a href="{{ blog_article.url }}" class="continue-exploring__item{% unless section.settings.grayscale_images %} continue-exploring__item--color{% endunless %}">
            <span class="continue-exploring__media">
              {%- if tile_image != blank -%}
                {%- comment -%}
                  Every tile here is the 382:654 portrait card, so both sources
                  are cropped to that ratio server-side instead of being left for
                  object-fit to crop in the browser: covering a portrait box with
                  a wide file throws away most of every pixel downloaded. On an
                  export that is already 382:654 the crop is a no-op.

                  Widths are capped at what a portrait crop can actually yield.
                  A 2880x1280 desktop hero gives 1280 x 0.584 = 748px of real
                  width, and an 804x1032 mobile hero gives 603px; asking for
                  more would declare a srcset width Shopify cannot deliver and
                  the browser would pick a file softer than its descriptor
                  promises.
                {%- endcomment -%}
                <picture class="continue-exploring__picture">
                  {%- if tile_image_mobile != blank -%}
                    <source
                      media="(max-width: 749px)"
                      srcset="
                        {{ tile_image_mobile | image_url: width: 320, height: 548, crop: 'center' }} 320w,
                        {{ tile_image_mobile | image_url: width: 400, height: 685, crop: 'center' }} 400w,
                        {{ tile_image_mobile | image_url: width: 480, height: 822, crop: 'center' }} 480w,
                        {{ tile_image_mobile | image_url: width: 603, height: 1032, crop: 'center' }} 603w
                      "
                      sizes="82vw"
                    >
                  {%- endif -%}
                  <img
                    class="continue-exploring__image"
                    src="{{ tile_image | image_url: width: 764, height: 1308, crop: 'center' }}"
                    srcset="
                      {{ tile_image | image_url: width: 320, height: 548, crop: 'center' }} 320w,
                      {{ tile_image | image_url: width: 400, height: 685, crop: 'center' }} 400w,
                      {{ tile_image | image_url: width: 480, height: 822, crop: 'center' }} 480w,
                      {{ tile_image | image_url: width: 640, height: 1096, crop: 'center' }} 640w,
                      {{ tile_image | image_url: width: 748, height: 1280, crop: 'center' }} 748w
                    "
                    sizes="(min-width: 1400px) 330px, (min-width: 1280px) 24vw, (min-width: 990px) 31vw, (min-width: 750px) 47vw, 82vw"
                    alt="{{ tile_alt }}"
                    loading="lazy"
                    width="382"
                    height="654"
                  >
                </picture>
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'continue-exploring__image placeholder-svg' }}
              {%- endif -%}

              <span class="continue-exploring__scrim"></span>

              <span class="continue-exploring__text">
                <span class="continue-exploring__number">{{ index_padded }}</span>
                <span class="continue-exploring__title">{{ blog_article.title }}</span>
              </span>

              <span class="continue-exploring__icons">
                {%- if section.settings.star_icon -%}
                  <img
                    src="{{ section.settings.star_icon | image_url: width: 80 }}"
                    alt=""
                    class="continue-exploring__icon continue-exploring__icon--star"
                    loading="lazy"
                    width="28"
                    height="28"
                  >
                {%- endif -%}
                {%- if section.settings.arrow_icon -%}
                  <img
                    src="{{ section.settings.arrow_icon | image_url: width: 240 }}"
                    alt=""
                    class="continue-exploring__icon continue-exploring__icon--arrow"
                    loading="lazy"
                    width="120"
                    height="24"
                  >
                {%- endif -%}
              </span>
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="continue-exploring__empty">Select a blog in the section settings to feature its articles.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Continue Exploring",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Rituals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Continue Exploring"
    },
    {
      "type": "header",
      "content": "Blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Articles from this blog populate the grid automatically."
    },
    {
      "type": "range",
      "id": "article_limit",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Number of articles to show",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "grayscale_images",
      "label": "Grayscale images",
      "default": true
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "image_picker",
      "id": "star_icon",
      "label": "Star icon"
    },
    {
      "type": "image_picker",
      "id": "arrow_icon",
      "label": "Arrow icon"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Continue Exploring"
    }
  ]
}
{% endschema %}
