{{ 'custom-images-grid_carousal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-images-grid_carousal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  # Images set the height of the row; videos are cropped to match it. With no
  # image in the section there is nothing to match, so videos fall back to
  # their own aspect ratio.
  #
  # Every card is the same width, so the tallest image is the one with the
  # smallest width/height ratio. Each card takes that ratio and the others
  # cover-crop to it -- worked out here from the image data rather than from
  # layout, so the row is the same height on every breakpoint and doesn't wait
  # on lazy images to find out how tall it is.
  assign has_image = false
  assign tallest_ratio = 0
  for block in section.blocks
    if block.settings.desktop_image != blank
      assign has_image = true
      assign ratio = block.settings.desktop_image.aspect_ratio
      if tallest_ratio == 0 or ratio < tallest_ratio
        assign tallest_ratio = ratio
      endif
    endif
  endfor
-%}

<div
  class="custom-images-grid_carousal-container{% unless has_image %} custom-images-grid_carousal-container--no-image{% endunless %}"
  data-section-id="{{ section.id }}"
  data-default-language="{{ section.settings.default_language }}"
  style="--images-per-view: {{ section.settings.images_per_view }};{% if has_image %} --tallest-ratio: {{ tallest_ratio }};{% endif %}"
>
  {% for block in section.blocks %}
    {%- liquid
      assign image = block.settings.desktop_image
      assign video = block.settings.desktop_video
      assign block_link = block.settings.link

      assign wrapper_tag = 'div'
      if block_link != blank
        assign wrapper_tag = 'a'
      endif
    -%}
    {%- if image == blank and video == blank -%}
      {% continue %}
    {%- endif -%}
    <{{ wrapper_tag }}
      class="custom-images-grid_carousal-item{% if image == blank %} custom-images-grid_carousal-item--video{% endif %}"
      {% if block_link != blank %}
        href="{{ block_link }}"
        {% if block.settings.open_in_new_tab %}
          target="_blank"
          rel="noopener"
        {% endif %}
      {% endif %}
      {{ block.shopify_attributes }}
    >
      {%- if image != blank -%}
        <img
          loading="lazy"
          decoding="async"
          src="{{ image | image_url }}"
          alt="{{ image.alt | escape }}"
          width="{{ image.width }}"
          height="{{ image.height }}"
          class="custom-images-grid_carousal-image"
        >
      {%- else -%}
        {{
          video
          | video_tag:
            class: 'custom-images-grid_carousal-video',
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true
        }}
      {%- endif -%}
    </{{ wrapper_tag }}>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Custom Image Carousel",
  "settings": [
    {
      "type": "range",
      "id": "images_per_view",
      "label": "Images per row (desktop)",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Image",
          "info": "Used on both desktop and mobile."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave blank to keep the image unclickable."
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in a new tab",
          "default": false
        }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "desktop_video",
          "label": "Video",
          "info": "Used on both desktop and mobile. Cropped from the top and bottom to match the height of the images in this section."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave blank to keep the video unclickable."
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in a new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Image Carousel"
    }
  ]
}
{% endschema %}
