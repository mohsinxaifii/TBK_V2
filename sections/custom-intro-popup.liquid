{{ 'custom-intro-popup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-intro-popup.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cta_url = section.settings.cta_1_link | default: '/collections/the-bhandaar'
  assign video_desktop = section.settings.video_url | strip
  assign video_mobile = section.settings.video_url_mobile | strip | default: video_desktop
  assign poster_desktop = section.settings.image
  assign poster_mobile = section.settings.image_mobile | default: poster_desktop
-%}

{%- if section.settings.enabled -%}
  <div
    class="custom-intro-popup"
    id="CustomIntroPopup-{{ section.id }}"
    data-custom-intro-popup
    data-delay="{{ section.settings.delay_seconds }}"
    data-frequency="{{ section.settings.frequency }}"
    {%- comment -%}
      The overlay is the scrollable box, so it is the element Lenis has to keep
      its hands off — while Lenis is stopped it preventDefaults wheel events
      outright unless something in the path opted out.
    {%- endcomment -%}
    data-lenis-prevent
    hidden
  >
    <div
      class="custom-intro-popup__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="CustomIntroPopupHeading-{{ section.id }}"
    >
      <div class="custom-intro-popup__media">
        {%- comment -%}
          One video per breakpoint (3702:4182 desktop, 3699:4115 mobile). Both
          carry their URL in data-src rather than src: the JS only loads the one
          that matches the viewport, and only for visitors who are going to see
          the popup, so returning visitors never download either.
        {%- endcomment -%}
        {%- if video_desktop != blank -%}
          <video
            class="custom-intro-popup__video custom-intro-popup__video--desktop"
            data-src="{{ video_desktop | escape }}"
            data-media="(min-width: 750px)"
            {% if poster_desktop != blank %}poster="{{ poster_desktop | image_url: width: 900 }}"{% endif %}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
          ></video>
          <video
            class="custom-intro-popup__video custom-intro-popup__video--mobile"
            data-src="{{ video_mobile | escape }}"
            data-media="(max-width: 749px)"
            {% if poster_mobile != blank %}poster="{{ poster_mobile | image_url: width: 720 }}"{% endif %}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
          ></video>
        {%- endif -%}
      </div>

      {%- comment -%}
        The two breakpoints use different lockups: desktop has the shadowed
        132×68 wordmark, mobile a smaller 91×44 one with no shadow.
      {%- endcomment -%}
      <img
        class="custom-intro-popup__wordmark custom-intro-popup__wordmark--desktop"
        src="{{ 'intro-popup-wordmark.svg' | asset_url }}"
        alt=""
        width="132"
        height="68"
        aria-hidden="true"
      >
      <img
        class="custom-intro-popup__wordmark custom-intro-popup__wordmark--mobile"
        src="{{ 'intro-popup-wordmark-mobile.svg' | asset_url }}"
        alt=""
        width="91"
        height="44"
        aria-hidden="true"
      >

      <button
        type="button"
        class="custom-intro-popup__close"
        data-custom-intro-popup-close
        aria-label="{{ 'accessibility.close' | t }}"
      >
        <svg class="custom-intro-popup__close-icon" viewBox="0 0 14.5 13.5" fill="none" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
          <path d="M0.750004 12.75L13.75 0.750004M0.750004 0.750004L13.75 12.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>

      {%- comment -%}
        The two four-point stars sit in the card's bottom corners at both sizes.
      {%- endcomment -%}
      <img
        class="custom-intro-popup__ornament custom-intro-popup__ornament--start"
        src="{{ 'intro-popup-ornament.svg' | asset_url }}"
        alt=""
        width="19"
        height="19"
        aria-hidden="true"
      >
      <img
        class="custom-intro-popup__ornament custom-intro-popup__ornament--end"
        src="{{ 'intro-popup-ornament.svg' | asset_url }}"
        alt=""
        width="19"
        height="19"
        aria-hidden="true"
      >

      <div class="custom-intro-popup__content">
        <div class="custom-intro-popup__text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="custom-intro-popup__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="custom-intro-popup__heading" id="CustomIntroPopupHeading-{{ section.id }}">
              {{- section.settings.heading | escape -}}
            </h2>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <p class="custom-intro-popup__body">{{ section.settings.body | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.cta_1_label != blank -%}
          <div class="custom-intro-popup__actions">
            <a class="custom-intro-popup__cta" href="{{ cta_url }}">
              <span class="custom-intro-popup__cta-label">{{ section.settings.cta_1_label }}</span>
              <img
                class="custom-intro-popup__cta-arrow"
                src="{{ 'intro-popup-arrow.svg' | asset_url }}"
                alt=""
                width="24.4"
                height="10.3095"
                aria-hidden="true"
              >
            </a>
          </div>
        {%- endif -%}

        {%- if section.settings.note != blank -%}
          <p class="custom-intro-popup__note">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Intro Popup",
  "tag": "div",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows once to first-time visitors, on whichever template this section is added to. In the theme editor it reopens every reload so you can style it."
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Delay before showing",
      "unit": "s",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 5,
      "info": "Counted from when the page preloader finishes."
    },
    {
      "type": "select",
      "id": "frequency",
      "label": "Show again",
      "options": [
        { "value": "once", "label": "Never — first visit only" },
        { "value": "session", "label": "Once per browser session" }
      ],
      "default": "once"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A limited gifting edition",
      "info": "The small uppercase line above the heading."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "A little more to give.",
      "info": "Wraps on its own at both sizes — no manual line breaks needed."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "This Diwali, Our Paraat Bhujia comes wrapped in a bundle of love : The Gathri packaging.\nA thoughtful way to share a taste of Bikaner with those who matter.",
      "info": "Press Enter/Return for a line break."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "*Available until 8 November",
      "info": "Desktop: the bottom of the card. Mobile: under the button."
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (desktop)",
      "default": "https://cdn.shopify.com/videos/c/o/v/4c33101a7aee4165aebfb4666b2d9296.mp4",
      "info": "MP4 link, e.g. from Content › Files. Fills the left panel — a portrait clip (around 6:7) fits it best."
    },
    {
      "type": "text",
      "id": "video_url_mobile",
      "label": "Video URL (mobile)",
      "default": "https://cdn.shopify.com/videos/c/o/v/1a346f8f4b394a78968725e01b34257e.mp4",
      "info": "Fills the square block at the top of the card. Falls back to the desktop video."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Poster image (desktop)",
      "info": "Optional. Shown while the video loads — use a still from the video."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Poster image (mobile)",
      "info": "Optional. Falls back to the desktop poster."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_1_label",
      "label": "Button label",
      "default": "Step Into the Tradition"
    },
    {
      "type": "url",
      "id": "cta_1_link",
      "label": "Button link",
      "info": "Defaults to /collections/the-bhandaar when left empty."
    }
  ],
  "presets": [
    {
      "name": "Custom Intro Popup"
    }
  ]
}
{% endschema %}
