{{ 'custom-intro-popup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-intro-popup.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cta_url = section.settings.cta_1_link | default: '/collections/the-bhandaar'
-%}

{%- if section.settings.enabled -%}
  <div
    class="custom-intro-popup"
    id="CustomIntroPopup-{{ section.id }}"
    data-custom-intro-popup
    data-delay="{{ section.settings.delay_seconds }}"
    data-frequency="{{ section.settings.frequency }}"
    {%- comment -%}
      The overlay is the scrollable box, so it is the element Lenis has to keep
      its hands off — while Lenis is stopped it preventDefaults wheel events
      outright unless something in the path opted out.
    {%- endcomment -%}
    data-lenis-prevent
    hidden
  >
    <div
      class="custom-intro-popup__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="CustomIntroPopupHeading-{{ section.id }}"
    >
      <div class="custom-intro-popup__media">
        {%- if section.settings.image != blank -%}
          {%- comment -%}
            The photograph is the card's background and is supplied plain: the
            maroon falloff behind the copy is the __scrim layer below, a real
            blurred rectangle as in the design (3231:5339 / 3231:5311), not
            baked into the export as it used to be.

            Eager, despite being off-screen: the overlay starts at display:none,
            and browsers don't fetch lazy images inside a hidden box — the photo
            would only start downloading as the popup opened, and pop in late.
            fetchpriority=low keeps it out of the way of the banner's LCP.
          {%- endcomment -%}
          <picture class="custom-intro-popup__picture">
            {%- if section.settings.image_mobile != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="
                  {{ section.settings.image_mobile | image_url: width: 354 }} 354w,
                  {{ section.settings.image_mobile | image_url: width: 708 }} 708w
                "
                sizes="354px"
                width="{{ section.settings.image_mobile.width }}"
                height="{{ section.settings.image_mobile.height }}"
              >
            {%- endif -%}
            <img
              class="custom-intro-popup__image"
              src="{{ section.settings.image | image_url: width: 864 }}"
              srcset="
                {{ section.settings.image | image_url: width: 864 }} 864w,
                {{ section.settings.image | image_url: width: 1728 }} 1728w
              "
              sizes="864px"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              alt="{{ section.settings.image.alt | escape }}"
              loading="eager"
              fetchpriority="low"
            >
          </picture>
        {%- endif -%}
        {%- comment -%}
          Mobile only in the design: an even wash over the whole photo, on top
          of which the blurred scrim darkens the lower half where the copy sits.
        {%- endcomment -%}
        <span class="custom-intro-popup__tint"></span>
        <span class="custom-intro-popup__scrim"></span>
      </div>

      <img
        class="custom-intro-popup__wordmark"
        src="{{ 'intro-popup-wordmark.svg' | asset_url }}"
        alt=""
        width="132"
        height="68"
        aria-hidden="true"
      >

      <button
        type="button"
        class="custom-intro-popup__close"
        data-custom-intro-popup-close
        aria-label="{{ 'accessibility.close' | t }}"
      >
        <svg class="custom-intro-popup__close-icon" viewBox="0 0 14.5 13.5" fill="none" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
          <path d="M0.750004 12.75L13.75 0.750004M0.750004 0.750004L13.75 12.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>

      {%- comment -%}
        The two four-point stars. Desktop stacks them down the left edge of the
        photo (3231:5352); mobile puts them in the bottom corners under the
        button (3231:5330). Absolute at both sizes so one pair of elements
        serves both, with the card's bottom padding on mobile keeping the copy
        clear of them.
      {%- endcomment -%}
      <img
        class="custom-intro-popup__ornament custom-intro-popup__ornament--start"
        src="{{ 'intro-popup-ornament.svg' | asset_url }}"
        alt=""
        width="19"
        height="19"
        aria-hidden="true"
      >
      <img
        class="custom-intro-popup__ornament custom-intro-popup__ornament--end"
        src="{{ 'intro-popup-ornament.svg' | asset_url }}"
        alt=""
        width="19"
        height="19"
        aria-hidden="true"
      >

      <div class="custom-intro-popup__content">
        <div class="custom-intro-popup__text">
          {%- if section.settings.heading != blank -%}
            <h2 class="custom-intro-popup__heading" id="CustomIntroPopupHeading-{{ section.id }}">
              {{- section.settings.heading | escape -}}
            </h2>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <p class="custom-intro-popup__body">{{ section.settings.body | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.welcome != blank -%}
          <p class="custom-intro-popup__welcome">{{ section.settings.welcome | escape }}</p>
        {%- endif -%}

        {%- if section.settings.cta_1_label != blank -%}
          <div class="custom-intro-popup__actions">
            <a class="custom-intro-popup__cta" href="{{ cta_url }}">
              <span class="custom-intro-popup__cta-label">{{ section.settings.cta_1_label }}</span>
              <img
                class="custom-intro-popup__cta-arrow"
                src="{{ 'intro-popup-arrow.svg' | asset_url }}"
                alt=""
                width="24.4"
                height="10.3095"
                aria-hidden="true"
              >
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Intro Popup",
  "tag": "div",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows once to first-time visitors, on whichever template this section is added to. In the theme editor it reopens every reload so you can style it."
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Delay before showing",
      "unit": "s",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 5,
      "info": "Counted from when the page preloader finishes."
    },
    {
      "type": "select",
      "id": "frequency",
      "label": "Show again",
      "options": [
        { "value": "once", "label": "Never — first visit only" },
        { "value": "session", "label": "Once per browser session" }
      ],
      "default": "once"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Some doors open into a place. Some open into a world.",
      "info": "Wraps on its own at both sizes — no manual line breaks needed."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Ours opens into Bikaner.\nIts kitchens, its people, its stories, and the tastes they have carried for generations.",
      "info": "Press Enter/Return for a line break."
    },
    {
      "type": "text",
      "id": "welcome",
      "label": "Welcome line",
      "default": "Welcome to The Bikaneri Kitchen",
      "info": "The bold line between the body copy and the button."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (desktop)",
      "info": "Fills the 864×504 card. Supply the plain photograph — the maroon falloff behind the text is drawn by the theme, so an export with it already baked in will read twice as dark."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile)",
      "info": "Fills the 354×714 card. Falls back to the desktop image, which would crop heavily — supply this one."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_1_label",
      "label": "Button label",
      "default": "Step Inside"
    },
    {
      "type": "url",
      "id": "cta_1_link",
      "label": "Button link",
      "info": "Defaults to /collections/the-bhandaar when left empty."
    }
  ],
  "presets": [
    {
      "name": "Custom Intro Popup"
    }
  ]
}
{% endschema %}
